# ==========================================
# SERVER CONFIGURATION
# ==========================================

PORT=5000
NODE_ENV=development

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

MONGO_URI=mongodb://127.0.0.1:27017/carescope

# Agar MongoDB Atlas use karna ho to:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/carescope

# ==========================================
# JWT CONFIGURATION
# ==========================================

JWT_SECRET=Replace_This_With_A_Very_Long_Secret_Key_2026
JWT_EXPIRE=7d

# ==========================================
# EMAIL CONFIGURATION
# ==========================================

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# ==========================================
# FILE UPLOAD CONFIGURATION
# ==========================================

MAX_FILE_SIZE=5242880

# ==========================================
# FRONTEND URL
# ==========================================

CLIENT_URL=http://localhost:3000   